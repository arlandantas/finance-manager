generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Baseline de EN-001: tabela técnica mínima para validar migrate/seed/health.
model SystemInfo {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum Role {
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
  DECLINED // SEC-004: o convidado recusou
}

enum EmailStatus {
  SENT
  FAILED
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum SplitKind {
  EQUAL
  PROPORTIONAL
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
}

enum TransactionKind {
  EXPENSE
  INCOME
  OPENING
  TRANSFER_OUT
  TRANSFER_IN
  INVOICE_PAYMENT
}

enum PlannedExpenseStatus {
  PREVISTO
  PAGO
}

// US-051 (SDD-017, ADR-023): despesa ou receita prevista na mesma tabela (kind imutável; padrão EXPENSE)
enum PlannedKind {
  EXPENSE
  INCOME
}

// US-100 (ADR-037): transferência prevista entre contas
enum PlannedTransferStatus {
  PREVISTA
  EFETIVADA
}

enum Direction {
  CREDIT
  DEBIT
}

enum DeletionReason {
  DELETED
  UNDONE
}

enum TransferGroupKind {
  TRANSFER
  SETTLEMENT
}

enum RevisionAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  UNDO
}

// ───────── Auth.js (adaptador Prisma) ─────────
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique // SEMPRE minúsculo (normalizado no adaptador)
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  // SEC-017c (US-080): conta excluída = identidade anonimizada (nome "Conta excluída", e-mail inválido sem PII).
  // A linha fica porque `members`/`transactions` a referenciam (ADR-019); ela nunca mais autentica.
  deletedAt     DateTime? @db.Timestamptz(3)

  accounts    Account[]
  sessions    Session[]
  members     Member[]
  idempotency IdempotencyRecord[]

  @@map("users")
}

// Modelo do Auth.js (NÃO é a conta bancária; esta se chama BankAccount).
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique // SEC-018: sha256(token) em hex; o banco nunca guarda o token
  sessionToken String?   @unique // LEGADO: só leitura pelo código antigo durante o deploy; removido na fase 2
  userId       String    @db.Uuid
  expires      DateTime  @db.Timestamptz(3) // ociosidade (deslizante, 30 dias)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3) // base do prazo absoluto (90 dias)
  // DEV-91/US-035: sessão de quem foi removido da família. Deixa de autenticar na hora; a linha só serve para
  // mostrar o aviso único "acesso encerrado" no próximo acesso (e é apagada ali ou pelo expurgo).
  endedAt      DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ───────── Núcleo familiar ─────────
model Family {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  cutDay    Int      @default(1) // CHECK 1..28; sem UI no R1 (ADR-010)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // US-028: acerto de contas opcional; `version` protege o conflito de edição ("alterada por")
  settlementEnabled      Boolean     @default(true)
  // EN-002 (ADR-016/021): motor do acerto da família; novas famílias nascem STORED (o serviço grava)
  splitEngine            SplitEngine @default(LEGACY)
  version                Int         @default(1)
  updatedAt              DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByMemberId      String?     @db.Uuid
  // EN-004 (SDD-021 §5): sobrescrita do teto mensal de IA (centavos); nulo = padrão do ambiente
  aiMonthlyCapCents      Int?
  // EN-006a (ADR-030 §4): o Administrador pode bloquear o acesso por assistente (MCP) da família inteira
  assistantAccessEnabled Boolean     @default(true)

  llmBudgetMonths              LlmBudgetMonth[]
  llmUsageEvents               LlmUsageEvent[]
  spendingAnalyses             SpendingAnalysis[]
  avoidableDismissals          AvoidableDismissal[]
  categorySuggestionDismissals CategorySuggestionDismissal[]
  settlementReviewDismissals   SettlementReviewDismissal[]
  aiConsentEvents              AiConsentEvent[]
  mcpGrants                    McpGrant[]
  mcpAuditEvents               McpAuditEvent[]
  members                      Member[]
  familyEvents                 FamilyEvent[]
  invitations                  Invitation[]
  categories                   Category[]
  splitRules                   SplitRuleVersion[]
  bankAccounts                 BankAccount[]
  creditCards                  CreditCard[]
  plannedExpenses              PlannedExpense[]
  plannedTransfers             PlannedTransfer[]
  recurringTransfers           RecurringTransfer[]
  recurringExpenses            RecurringExpense[]
  cardSubscriptions            CardSubscription[]
  cardSubscriptionAmounts      CardSubscriptionAmount[]
  subscriptionCharges          SubscriptionCharge[]
  installmentPlans             InstallmentPlan[]
  transactions                 Transaction[]
  tags                         Tag[]
  transferGroups               TransferGroup[]
  splitSnapshots               SplitMigrationSnapshot[]
  dataMigrations               DataMigration[]

  @@map("families")
}

enum SplitMode {
  NONE
  RULE
  CUSTOM
}

enum SplitEngine {
  LEGACY
  STORED
}

enum MemberRemovalKind {
  REMOVED
  LEFT
}

enum FamilyEventType {
  FAMILY_RENAMED
  ROLE_CHANGED
  SETTLEMENT_TOGGLED
  MEMBER_REMOVED
  MEMBER_LEFT
  INVITATION_RESENT
  AI_CONSENT_CHANGED // EN-005
  ASSISTANT_ACCESS_CHANGED // US-074
  MEMBER_JOINED // SEC-004: entrou por convite (aceite explícito)
  CARD_OWNER_CHANGED // SEC-042: troca de titular de cartão (quem trocou, de quem para quem)
  CARD_PAYER_ACCOUNT_CHANGED // US-089: conta pagadora padrão do cartão
  MEMBER_CREATED // US-092 (SDD-033): cadastro de membro sem conta (092b)
  MEMBER_UPDATED // US-095 (sem uso até lá)
  MEMBER_LINKED // US-094b (sem uso até lá)
  TAG_RENAMED // US-046 (SDD-016): gestão de tags (sem uso nesta fatia)
  TAG_MERGED
  TAG_DELETED
}

// Trilha append-only de eventos da família (trigger forbid_mutation em SQL cru)
model FamilyEvent {
  id             String          @id @default(uuid()) @db.Uuid
  familyId       String          @db.Uuid
  type           FamilyEventType
  actorMemberId  String          @db.Uuid
  targetMemberId String?         @db.Uuid
  changes        Json            @default("{}")
  at             DateTime        @default(now()) @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id])
  actor  Member @relation("EventActor", fields: [familyId, actorMemberId], references: [familyId, id])

  @@index([familyId, at(sort: Desc)])
  @@map("family_events")
}

model Member {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @db.Uuid
  // US-092 (ADR-033): nulo = membro cadastrado SEM conta (só metadado). NOT NULL caiu; CHECKs/gatilho em SQL cru
  // (members_unlinked_*_chk, members_pending_email_chk, members_name_len_chk, members_link_guard).
  userId            String?   @db.Uuid
  role              Role
  joinedAt          DateTime  @default(now()) @db.Timestamptz(3)
  // US-092: rótulo do cadastro (sem conta) ou nome escolhido no aceite (094b); zerado ao excluir a conta
  name              String?
  pendingEmail      String? // e-mail do cadastro sem conta; só ADMIN vê; apagado na remoção
  linkedAt          DateTime? @db.Timestamptz(3)
  createdByMemberId String?   @db.Uuid // FK composta em SQL cru

  // US-035 (ADR-019): ex-membro. Nunca se apaga `Member`; "ativo" = removedAt nulo
  removedAt           DateTime?          @db.Timestamptz(3)
  removedByMemberId   String?            @db.Uuid
  removalKind         MemberRemovalKind?
  removalNoticeAt     DateTime?          @db.Timestamptz(3)
  // US-076a (SDD-027 §R2.2): última conferência dos lançamentos via assistente (cartão da Home)
  assistantReviewedAt DateTime?          @db.Timestamptz(3)

  family          Family                 @relation(fields: [familyId], references: [id])
  user            User?                  @relation(fields: [userId], references: [id])
  invitations     Invitation[]
  assistantLimits MemberAssistantLimits?

  ownedAccounts                BankAccount[]
  ownedCards                   CreditCard[]
  plannedResponsible           PlannedExpense[]              @relation("PlannedResponsible")
  plannedAuthored              PlannedExpense[]              @relation("PlannedAuthor")
  plannedTransfersAuthored     PlannedTransfer[]             @relation("PlannedTransferAuthor")
  recurringTransfersAuthored   RecurringTransfer[]           @relation("RecurringTransferAuthor")
  recurringResponsible         RecurringExpense[]            @relation("RecurringResponsible")
  recurringAuthored            RecurringExpense[]            @relation("RecurringAuthor")
  subscriptionPayer            CardSubscription[]            @relation("SubscriptionPayer")
  subscriptionAuthor           CardSubscription[]            @relation("SubscriptionAuthor")
  subscriptionEnded            CardSubscription[]            @relation("SubscriptionEnder")
  subscriptionUpdated          CardSubscription[]            @relation("SubscriptionUpdater")
  subscriptionAmountsAuthored  CardSubscriptionAmount[]
  planPayer                    InstallmentPlan[]             @relation("PlanPayer")
  planAuthor                   InstallmentPlan[]             @relation("PlanAuthor")
  transactionSplits            TransactionSplit[]
  paidTransactions             Transaction[]                 @relation("TxPayer")
  authoredTransactions         Transaction[]                 @relation("TxAuthor")
  tagsCreated                  Tag[]                         @relation("TagCreator")
  tagsUpdated                  Tag[]                         @relation("TagUpdater")
  eventsAsActor                FamilyEvent[]                 @relation("EventActor")
  aiConsentEvents              AiConsentEvent[]
  mcpGrants                    McpGrant[]
  mcpAuditEvents               McpAuditEvent[]
  spendingAnalyses             SpendingAnalysis[]
  avoidableDismissals          AvoidableDismissal[]
  categorySuggestionDismissals CategorySuggestionDismissal[]
  settlementReviewDismissals   SettlementReviewDismissal[]

  @@unique([familyId, id])
  // Unicidade (userId) e (familyId, userId) só entre ATIVOS: índices parciais em SQL cru (r21_ex_membro)
  @@index([familyId, userId])
  @@map("members")
}

model Invitation {
  id                String           @id @default(uuid()) @db.Uuid
  familyId          String           @db.Uuid
  email             String // minúsculo
  role              Role             @default(MEMBER)
  tokenHash         String           @unique // sha256(token) em hex
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime         @db.Timestamptz(3)
  invitedByMemberId String           @db.Uuid
  emailStatus       EmailStatus
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt        DateTime?        @db.Timestamptz(3)
  acceptedByUserId  String?          @db.Uuid
  canceledAt        DateTime?        @db.Timestamptz(3)
  declinedAt        DateTime?        @db.Timestamptz(3) // SEC-004
  declinedByUserId  String?          @db.Uuid
  resendCount       Int              @default(0) // 0..3 (CHECK em SQL cru)
  lastSentAt        DateTime?        @db.Timestamptz(3)
  // US-092 (ADR-033): convite vinculado a um cadastro sem conta (uso a partir da 094a)
  memberId          String?          @db.Uuid

  family Family  @relation(fields: [familyId], references: [id])
  member Member? @relation(fields: [familyId, memberId], references: [familyId, id])

  @@index([familyId, status])
  @@index([email, status])
  @@map("invitations") // + índice único parcial (familyId, email) WHERE status = 'PENDING' (SQL cru)
}

model Category {
  id                String       @id @default(uuid()) @db.Uuid
  familyId          String       @db.Uuid
  name              String
  kind              CategoryKind
  icon              String // chave de ícone (ex.: "shopping-cart")
  sortOrder         Int
  archivedAt        DateTime?    @db.Timestamptz(3)
  // US-044: lançamentos novos nesta categoria nascem "Pela regra da família" (só despesa)
  defaultSplit      Boolean      @default(false)
  // US-014: conflito de edição ("alterada por {Nome}")
  version           Int          @default(1)
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByMemberId String?      @db.Uuid

  family                       Family                        @relation(fields: [familyId], references: [id])
  installmentPlans             InstallmentPlan[]
  transactions                 Transaction[]
  plannedExpenses              PlannedExpense[]
  recurringExpenses            RecurringExpense[]
  cardSubscriptions            CardSubscription[]
  avoidableDismissals          AvoidableDismissal[]
  categorySuggestionDismissals CategorySuggestionDismissal[]

  @@unique([familyId, kind, name])
  @@unique([familyId, id])
  @@map("categories")
}

// ───────── Contas, movimentações (ledger) ─────────
model BankAccount {
  id                   String          @id @default(uuid()) @db.Uuid
  familyId             String          @db.Uuid
  name                 String // trim; único por família ignorando caixa (índice em SQL cru)
  institution          String
  type                 BankAccountType
  ownerMemberId        String          @db.Uuid
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  // US-057: reserva — movimentável, mas fora do saldo disponível (SDD-019 §2)
  excludeFromAvailable Boolean         @default(false)
  // US-050 (SDD-017): cor do marcador; DEFAULT só mantém a migração compatível com a versão anterior
  // (expand); o serviço sempre grava a cor (escolhida ou `pickNextColor`).
  color                AccountColor    @default(BLUE)

  // US-032: arquivada some das listas; excluída (lógica, terminal) some de tudo e libera o nome
  archivedAt         DateTime? @db.Timestamptz(3)
  archivedByMemberId String?   @db.Uuid
  deletedAt          DateTime? @db.Timestamptz(3)
  deletedByMemberId  String?   @db.Uuid

  family            Family              @relation(fields: [familyId], references: [id])
  owner             Member              @relation(fields: [familyId, ownerMemberId], references: [familyId, id])
  transactions      Transaction[]
  plannedExpenses   PlannedExpense[]
  recurringExpenses RecurringExpense[]
  payerForCards     CreditCard[]
  plannedFrom       PlannedTransfer[]   @relation("PlannedTransferFrom") // US-100
  plannedTo         PlannedTransfer[]   @relation("PlannedTransferTo")
  recurringFrom     RecurringTransfer[] @relation("RecurringTransferFrom") // US-101
  recurringTo       RecurringTransfer[] @relation("RecurringTransferTo")

  @@unique([familyId, id])
  @@map("bank_accounts")
}

enum AccountColor {
  BLUE
  GREEN
  PURPLE
  ORANGE
  PINK
  TEAL
  RED
  YELLOW
  GRAY
  BROWN
}

// ───────── Cartões de crédito (US-015, SDD-008, ADR-014) ─────────
model CreditCard {
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @db.Uuid
  name              String // trim; único por família ignorando caixa (índice em SQL cru)
  institution       String   @default("Outro")
  ownerMemberId     String   @db.Uuid
  limitInCents      BigInt // > 0
  closingDay        Int // 1..28
  dueDay            Int // 1..28
  version           Int      @default(1)
  updatedByMemberId String?  @db.Uuid // "alterado por {Nome}" no 409
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  // US-033: arquivar e excluir (lógico, terminal), como nas contas
  archivedAt         DateTime? @db.Timestamptz(3)
  archivedByMemberId String?   @db.Uuid
  deletedAt          DateTime? @db.Timestamptz(3)
  deletedByMemberId  String?   @db.Uuid

  // US-089: conta que paga a fatura (só sugere; nunca decide pagamento)
  paymentAccountId String? @db.Uuid

  // US-050 (SDD-017): cor do marcador (ver BankAccount.color)
  color AccountColor @default(BLUE)

  family           Family             @relation(fields: [familyId], references: [id])
  owner            Member             @relation(fields: [familyId, ownerMemberId], references: [familyId, id])
  paymentAccount   BankAccount?       @relation(fields: [familyId, paymentAccountId], references: [familyId, id])
  invoices         CardInvoice[]
  installmentPlans InstallmentPlan[]
  transactions     Transaction[]
  subscriptions    CardSubscription[]

  @@unique([familyId, id])
  @@map("credit_cards")
}

// Fatura materializada sob demanda (primeira compra no ciclo). Total, limite e situação são derivados (ADR-014).
model CardInvoice {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  cardId         String   @db.Uuid
  referenceMonth String // "YYYY-MM" do mês de FECHAMENTO
  closingDate    DateTime @db.Date // snapshot do ciclo do cartão na criação
  dueDate        DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  card         CreditCard    @relation(fields: [familyId, cardId], references: [familyId, id])
  transactions Transaction[]

  @@unique([cardId, referenceMonth])
  @@unique([familyId, id])
  @@index([familyId, cardId, closingDate])
  @@map("card_invoices")
}

model TransferGroup {
  id                     String            @id @default(uuid()) @db.Uuid
  familyId               String            @db.Uuid
  kind                   TransferGroupKind
  occurredOn             DateTime          @db.Date
  settlementPeriod       String? // "YYYY-MM" (kind=SETTLEMENT)
  settlementFromMemberId String?           @db.Uuid // devedor
  settlementToMemberId   String?           @db.Uuid // credor
  authorMemberId         String            @db.Uuid
  version                Int               @default(1)
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  deletedAt              DateTime?         @db.Timestamptz(3) // desfeito
  deletedByMemberId      String?           @db.Uuid

  family Family           @relation(fields: [familyId], references: [id])
  legs   Transaction[]
  plan   PlannedTransfer? // US-100: prevista que originou a transferência

  @@unique([familyId, id])
  @@index([familyId, kind, settlementPeriod])
  @@map("transfer_groups")
}

model Transaction {
  id                 String            @id @default(uuid()) @db.Uuid
  familyId           String            @db.Uuid
  kind               TransactionKind
  direction          Direction
  accountId          String?           @db.Uuid // NULL só em compra no cartão (CHECK tx_kind_shape_chk)
  cardId             String?           @db.Uuid
  invoiceId          String?           @db.Uuid
  amountInCents      BigInt // magnitude (>0; OPENING pode ser 0)
  occurredOn         DateTime          @db.Date
  categoryId         String?           @db.Uuid // EXPENSE/INCOME: obrigatório; demais: nulo
  description        String // 2..100; padrão = nome da categoria; transferências: texto gerado
  note               String? // até 500
  payerMemberId      String?           @db.Uuid // EXPENSE/INCOME: quem pagou/recebeu (D-PO-01)
  isSharedExpense    Boolean           @default(false) // true só em EXPENSE comum
  authorMemberId     String            @db.Uuid // imutável
  updatedByMemberId  String?           @db.Uuid
  transferGroupId    String?           @db.Uuid
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?         @db.Timestamptz(3)
  deletedByMemberId  String?           @db.Uuid
  deletionReason     DeletionReason?
  // US-040 (ADR-017/020): parcela de compra parcelada. `competenceOn` é SEMPRE derivada pelo gatilho
  // tx_sync_competence (sem plano = occurredOn; parcela = closingDate da fatura); o default só evita exigi-la no create.
  installmentPlanId  String?           @db.Uuid
  installmentNo      Int?
  installmentCount   Int?
  competenceOn       DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  // EN-002 (ADR-016): rateio por lançamento. `NONE` = "Só meu" = sem linhas em transaction_splits.
  splitMode          SplitMode         @default(NONE)
  splitRuleVersionId String?           @db.Uuid
  // US-076a (SDD-027 §R2.2): lançamento direto pelo assistente. `assistantGrantId` sem FK rígida (a conexão pode ser expurgada)
  origin             TransactionOrigin @default(APP)
  assistantGrantId   String?           @db.Uuid
  assistantIdemKey   String?

  family             Family                @relation(fields: [familyId], references: [id])
  plan               InstallmentPlan?      @relation(fields: [familyId, installmentPlanId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  splitRule          SplitRuleVersion?     @relation(fields: [familyId, splitRuleVersionId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  splits             TransactionSplit[]
  account            BankAccount?          @relation(fields: [familyId, accountId], references: [familyId, id])
  card               CreditCard?           @relation(fields: [familyId, cardId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice            CardInvoice?          @relation(fields: [familyId, invoiceId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  category           Category?             @relation(fields: [familyId, categoryId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  payer              Member?               @relation("TxPayer", fields: [familyId, payerMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  author             Member                @relation("TxAuthor", fields: [familyId, authorMemberId], references: [familyId, id])
  group              TransferGroup?        @relation(fields: [familyId, transferGroupId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions          TransactionRevision[]
  paidPlanned        PlannedExpense?       @relation("PlannedPaidTx")
  tags               TransactionTag[]
  subscriptionCharge SubscriptionCharge?

  @@unique([familyId, id])
  @@unique([assistantGrantId, assistantIdemKey])
  @@index([familyId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([familyId, accountId])
  @@index([familyId, payerMemberId, occurredOn])
  @@index([familyId, kind, occurredOn])
  @@index([familyId, cardId, occurredOn])
  @@index([familyId, invoiceId])
  @@index([familyId, competenceOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "tx_family_competence_idx")
  @@index([familyId, kind, competenceOn], map: "tx_family_kind_competence_idx")
  @@index([familyId, origin, occurredOn])
  @@map("transactions")
}

// ───────── Tags livres (US-045, SDD-016, ADR-022): fora do ledger (permitem DELETE) ─────────
model Tag {
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @db.Uuid
  name              String // 1ª grafia, espaços internos já viram hífen (CHECK 2..30)
  nameKey           String // normalizeTagKey(name): único por família
  version           Int      @default(1)
  createdByMemberId String   @db.Uuid
  updatedByMemberId String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  family    Family           @relation(fields: [familyId], references: [id])
  createdBy Member           @relation("TagCreator", fields: [familyId, createdByMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Member?          @relation("TagUpdater", fields: [familyId, updatedByMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  links     TransactionTag[]

  @@unique([familyId, id])
  @@unique([familyId, nameKey])
  @@map("tags")
}

// Só EXPENSE/INCOME (gatilho transaction_tags_kind em SQL cru)
model TransactionTag {
  transactionId String @db.Uuid
  tagId         String @db.Uuid
  familyId      String @db.Uuid

  transaction Transaction @relation(fields: [familyId, transactionId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  tag         Tag         @relation(fields: [familyId, tagId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([transactionId, tagId])
  @@index([tagId, transactionId])
  @@map("transaction_tags")
}

// ───────── Compra parcelada (US-040, ADR-017/020, SDD-014): cabeçalho SEM valor próprio no ledger ─────────
model InstallmentPlan {
  id                 String    @id @default(uuid()) @db.Uuid
  familyId           String    @db.Uuid
  cardId             String    @db.Uuid
  totalInCents       BigInt // total ORIGINAL (> 0); o corrente é derivado das parcelas
  installmentCount   Int // 2..24
  purchaseOn         DateTime  @db.Date // data nominal da 1ª parcela LANÇADA (= data da compra quando paidBeforeAppCount = 0)
  paidBeforeAppCount Int       @default(0) // ADR-027: parcelas 1..P pagas antes do app; imutável (trigger)
  description        String // 2..100, sem o sufixo "n/N"
  note               String?
  categoryId         String    @db.Uuid
  payerMemberId      String    @db.Uuid
  authorMemberId     String    @db.Uuid
  updatedByMemberId  String?   @db.Uuid
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  deletedByMemberId  String?   @db.Uuid

  family   Family        @relation(fields: [familyId], references: [id])
  card     CreditCard    @relation(fields: [familyId, cardId], references: [familyId, id])
  category Category      @relation(fields: [familyId, categoryId], references: [familyId, id])
  payer    Member        @relation("PlanPayer", fields: [familyId, payerMemberId], references: [familyId, id])
  author   Member        @relation("PlanAuthor", fields: [familyId, authorMemberId], references: [familyId, id])
  parcels  Transaction[]

  @@unique([familyId, id])
  @@index([familyId, cardId, purchaseOn])
  @@map("installment_plans")
}

// ───────── Despesas previstas (US-018/019, SDD-009, ADR-015): NÃO é Transaction ─────────
model PlannedExpense {
  id                  String               @id @default(uuid()) @db.Uuid
  familyId            String               @db.Uuid
  description         String // 2..100
  amountInCents       BigInt // PREVISTO (> 0); o valor pago vive na Transaction
  dueOn               DateTime             @db.Date
  categoryId          String               @db.Uuid
  responsibleMemberId String               @db.Uuid
  isSharedExpense     Boolean              @default(false)
  note                String?
  status              PlannedExpenseStatus @default(PREVISTO)
  paidTransactionId   String?              @unique @db.Uuid
  authorMemberId      String               @db.Uuid
  updatedByMemberId   String?              @db.Uuid
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  deletedByMemberId   String?              @db.Uuid
  // US-058/059: ocorrência de série e conta de pagamento (SDD-019 §3.1)
  seriesId            String?              @db.Uuid
  occurrenceMonth     DateTime?            @db.Date
  isException         Boolean              @default(false)
  paymentAccountId    String?              @db.Uuid
  kind                PlannedKind          @default(EXPENSE) // US-051: imutável após a criação
  // US-043: rateio da previsão. `splitShares` = [{ memberId, bps }] só em CUSTOM; RULE resolve na data da baixa.
  splitMode           SplitMode            @default(NONE)
  splitShares         Json?

  family         Family            @relation(fields: [familyId], references: [id])
  series         RecurringExpense? @relation(fields: [familyId, seriesId], references: [familyId, id])
  paymentAccount BankAccount?      @relation(fields: [familyId, paymentAccountId], references: [familyId, id])
  category       Category          @relation(fields: [familyId, categoryId], references: [familyId, id])
  responsible    Member            @relation("PlannedResponsible", fields: [familyId, responsibleMemberId], references: [familyId, id])
  author         Member            @relation("PlannedAuthor", fields: [familyId, authorMemberId], references: [familyId, id])
  paidTx         Transaction?      @relation("PlannedPaidTx", fields: [familyId, paidTransactionId], references: [familyId, id])

  @@unique([familyId, id])
  @@unique([familyId, paidTransactionId])
  @@unique([familyId, seriesId, occurrenceMonth]) // sem filtro de deletedAt: nunca recria (ADR-025)
  @@index([familyId, status, dueOn])
  @@index([familyId, kind, status, dueOn])
  @@map("planned_expenses")
}

// US-058 (ADR-025, SDD-019 §3.1): série mensal; as ocorrências são linhas de planned_expenses
model RecurringExpense {
  id                    String    @id @default(uuid()) @db.Uuid
  familyId              String    @db.Uuid
  description           String // 2..100
  amountInCents         BigInt // > 0 (CHECK)
  categoryId            String    @db.Uuid
  responsibleMemberId   String    @db.Uuid
  isSharedExpense       Boolean   @default(false)
  paymentAccountId      String?   @db.Uuid
  dayOfMonth            Int // 1..31 (CHECK)
  startMonth            DateTime  @db.Date // dia 1
  endMonth              DateTime? @db.Date // dia 1; null = sem fim
  generatedThroughMonth DateTime? @db.Date // último mês já materializado
  endedAt               DateTime? @db.Timestamptz(3)
  endedByMemberId       String?   @db.Uuid
  authorMemberId        String    @db.Uuid
  updatedByMemberId     String?   @db.Uuid
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  family              Family               @relation(fields: [familyId], references: [id])
  category            Category             @relation(fields: [familyId, categoryId], references: [familyId, id])
  responsible         Member               @relation("RecurringResponsible", fields: [familyId, responsibleMemberId], references: [familyId, id])
  author              Member               @relation("RecurringAuthor", fields: [familyId, authorMemberId], references: [familyId, id])
  paymentAccount      BankAccount?         @relation(fields: [familyId, paymentAccountId], references: [familyId, id])
  occurrences         PlannedExpense[]
  avoidableDismissals AvoidableDismissal[]

  @@unique([familyId, id])
  @@index([familyId, endedAt, generatedThroughMonth])
  @@map("recurring_expenses")
}

// Append-only (trigger no banco)
model TransactionRevision {
  id            String         @id @default(uuid()) @db.Uuid
  familyId      String         @db.Uuid
  transactionId String         @db.Uuid
  revision      Int // = version resultante
  action        RevisionAction
  actorMemberId String         @db.Uuid
  at            DateTime       @default(now()) @db.Timestamptz(3)
  changes       Json // [{ field, from, to }]; CREATE: snapshot em "to"

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, revision, action])
  @@index([familyId, transactionId, at])
  @@map("transaction_revisions")
}

// ───────── Divisão (SDD-002) ─────────
model SplitRuleVersion {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @db.Uuid
  kind              SplitKind
  effectiveFrom     DateTime  @db.Date
  createdByMemberId String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  family       Family        @relation(fields: [familyId], references: [id])
  shares       SplitShare[]
  transactions Transaction[]

  @@unique([familyId, id]) // SEC-024: alvo da FK composta de transactions
  @@index([familyId, effectiveFrom(sort: Desc), createdAt(sort: Desc)])
  @@map("split_rule_versions")
}

// ───────── Rateio por lançamento (EN-002, ADR-016): `bps` = intenção; `amountInCents` = valor debitado da cota ─────────
model TransactionSplit {
  transactionId String @db.Uuid
  familyId      String @db.Uuid
  memberId      String @db.Uuid
  bps           Int
  amountInCents BigInt

  // `Cascade` é só do Prisma/FK: `transactions` proíbe DELETE por gatilho, então nunca dispara
  transaction Transaction @relation(fields: [familyId, transactionId], references: [familyId, id], onDelete: Cascade)
  member      Member      @relation(fields: [familyId, memberId], references: [familyId, id], onDelete: Restrict)

  @@id([transactionId, memberId])
  @@index([familyId, memberId])
  @@map("transaction_splits")
}

// "Antes" do gate da migração (ADR-021 §5): fotografia do acerto LEGACY por período
model SplitMigrationSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @db.Uuid
  periodKey String
  payload   Json
  takenAt   DateTime @default(now()) @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id])

  @@unique([familyId, periodKey])
  @@map("split_migration_snapshots")
}

model DataMigration {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  familyId   String    @db.Uuid
  state      String
  finishedAt DateTime? @db.Timestamptz(3)
  report     Json?

  family Family @relation(fields: [familyId], references: [id])

  @@unique([name, familyId])
  @@map("data_migrations")
}

model SplitShare {
  id       String @id @default(uuid()) @db.Uuid
  ruleId   String @db.Uuid
  memberId String @db.Uuid
  bps      Int // 0..10000

  rule SplitRuleVersion @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, memberId])
  @@map("split_shares")
}

// ───────── Infra ─────────
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  key            String
  method         String
  path           String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// EN-004 (SDD-021 §5, ADR-028 §5): contador mensal de IA por família (micro-reais). Sem nenhuma coluna de conteúdo.
enum LlmPurpose {
  SPENDING_ANALYSIS
  INVOICE_IMPORT
}

enum LlmUsageStatus {
  RESERVED
  SETTLED
  FAILED
  ABANDONED
}

model LlmBudgetMonth {
  familyId         String   @db.Uuid
  month            String // "YYYY-MM" em America/Sao_Paulo
  spentMicroBrl    BigInt   @default(0)
  reservedMicroBrl BigInt   @default(0)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id])

  @@id([familyId, month])
  @@map("llm_budget_months")
}

// SEC-013: teto global mensal (soma de todas as famílias) com alarme em 50/80/100 %
model LlmGlobalBudgetMonth {
  month            String   @id // "YYYY-MM" America/Sao_Paulo
  spentMicroBrl    BigInt   @default(0)
  reservedMicroBrl BigInt   @default(0)
  alertedPct       Int      @default(0) // 0 | 50 | 80 | 100: maior limiar já alertado
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("llm_global_budget_months")
}

model LlmUsageEvent {
  id               String         @id @default(uuid()) @db.Uuid
  familyId         String         @db.Uuid
  month            String
  purpose          LlmPurpose
  memberId         String         @db.Uuid // quem pediu (não vai ao provedor)
  model            String
  status           LlmUsageStatus
  outcome          String? // ok|budget|timeout|unavailable|invalid|refused|cancelled|auth
  reservedMicroBrl BigInt
  costMicroBrl     BigInt?
  inputTokens      Int?
  outputTokens     Int?
  latencyMs        Int?
  attempts         Int?
  expiresAt        DateTime       @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  settledAt        DateTime?      @db.Timestamptz(3)

  // US-070 (SDD-023 §5): análise gerada com este consumo; apagar a análise zera o vínculo (o consumo fica)
  analysisId String? @db.Uuid

  family   Family            @relation(fields: [familyId], references: [id])
  analysis SpendingAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([familyId, month, status])
  @@map("llm_usage_events")
}

// EN-005 (SDD-022 §5, ADR-029 §1): consentimento por família e finalidade. Append-only (gatilho em SQL cru).
// Estado efetivo = último evento ENABLED com textVersion = versão vigente (calculado, nunca armazenado).
enum AiConsentAction {
  ENABLED
  DISABLED
}

model AiConsentEvent {
  id          String          @id @default(uuid()) @db.Uuid
  familyId    String          @db.Uuid
  purpose     LlmPurpose
  action      AiConsentAction
  textVersion Int
  memberId    String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id])
  member Member @relation(fields: [familyId, memberId], references: [familyId, id])

  @@index([familyId, purpose, createdAt(sort: Desc)])
  @@map("ai_consent_events")
}

// ───────── Análise de gastos por IA (SDD-023 §5) ─────────
model SpendingAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  familyId            String   @db.Uuid
  periodKey           String // "YYYY-MM"
  partial             Boolean
  requestedByMemberId String   @db.Uuid
  model               String
  promptVersion       Int
  payload             Json // exatamente o enviado (US-073 "O que foi enviado")
  result              Json // AnalysisResult reconciliado
  refMap              Json // SÓ local: C*/R* ⇒ ids/descrições (nunca vai à LLM)
  usageEventId        String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  family      Family          @relation(fields: [familyId], references: [id])
  requestedBy Member          @relation(fields: [familyId, requestedByMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)
  usageEvents LlmUsageEvent[]

  @@index([familyId, createdAt(sort: Desc)])
  @@index([familyId, periodKey])
  @@map("spending_analyses")
}

// US-071 (SDD-023 §5): "Importante para nós". O motivo opcional fica SÓ no banco (nunca é enviado à LLM).
model AvoidableDismissal {
  id                 String   @id @default(uuid()) @db.Uuid
  familyId           String   @db.Uuid
  kind               String // RECURRING | CATEGORY (CHECK)
  categoryId         String   @db.Uuid
  descriptionKey     String? // RECURRING detectado; SCHEDULED usa recurringExpenseId
  recurringExpenseId String?  @db.Uuid
  displayName        String
  reason             String? // ≤ 140, NUNCA enviado
  byMemberId         String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  family           Family            @relation(fields: [familyId], references: [id])
  category         Category          @relation(fields: [familyId, categoryId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)
  byMember         Member            @relation(fields: [familyId, byMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)
  recurringExpense RecurringExpense? @relation(fields: [familyId, recurringExpenseId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([familyId, createdAt(sort: Desc)])
  @@map("avoidable_dismissals")
}

// US-044: "Não perguntar de novo para este mês" na revisão de despesas "Só meu" do mês encerrado.
model SettlementReviewDismissal {
  familyId   String   @db.Uuid
  periodKey  String // YYYY-MM
  byMemberId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  family   Family @relation(fields: [familyId], references: [id])
  byMember Member @relation(fields: [familyId, byMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([familyId, periodKey])
  @@map("settlement_review_dismissals")
}

// US-072 (SDD-023 §5): "Recusar" uma sugestão local de categoria; vale para a família (regra local, sem IA).
model CategorySuggestionDismissal {
  familyId       String   @db.Uuid
  descriptionKey String
  toCategoryId   String   @db.Uuid
  byMemberId     String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  family     Family   @relation(fields: [familyId], references: [id])
  toCategory Category @relation(fields: [familyId, toCategoryId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)
  byMember   Member   @relation(fields: [familyId, byMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([familyId, descriptionKey, toCategoryId])
  @@map("category_suggestion_dismissals")
}

// ───────── Servidor MCP / servidor de autorização OAuth 2.1 (SDD-024 §2 + §11) ─────────
enum TransactionOrigin {
  APP
  ASSISTANT
  SUBSCRIPTION // US-096 (ADR-036): cobrança automática de assinatura no cartão
}

// US-076b (SDD-027 §R2.2): limites de lançamento do assistente, por MEMBRO; null = sem limite. Sem linha = padrões sugeridos.
model MemberAssistantLimits {
  familyId            String   @db.Uuid
  memberId            String   @db.Uuid
  maxAmountPerTxCents BigInt?
  maxTxPerDay         Int?
  maxTxPerHour        Int?
  version             Int      @default(1)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  member Member @relation(fields: [familyId, memberId], references: [familyId, id])

  @@id([familyId, memberId])
  @@map("member_assistant_limits")
}

enum McpClientKind {
  CIMD
  DCR
}

enum McpGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// Rev. 2 (§11.4): PAT fica para o backlog (US-074b), mas a coluna e o clientId opcional já existem.
enum McpGrantKind {
  OAUTH
  PAT
}

enum McpRevokedReason {
  MEMBER
  FAMILY_BLOCKED
  MEMBER_REMOVED
  REFRESH_REUSE
  CODE_REUSE
  CLIENT
}

enum McpTokenKind {
  CODE
  ACCESS
  REFRESH
}

enum McpAuditOutcome {
  OK
  DENIED_SCOPE
  INVALID
  RATE_LIMITED
  ERROR
  LIMIT_EXCEEDED // §11.3
}

enum McpAuditKind {
  TOOL
  CONNECTED
  REVOKED
  BLOCKED
  LIMITS_CHANGED // §11.3
}

// Cliente OAuth (CIMD ou DCR); sem segredo: só clientes públicos
model McpClient {
  id                 String        @id @default(uuid()) @db.Uuid
  clientId           String        @unique // URL do CIMD ou "dcr_<random>"
  kind               McpClientKind
  clientName         String
  redirectUris       String[]
  softwareId         String?
  metadataFetchedAt  DateTime?     @db.Timestamptz(3)
  registrationIpHash String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  lastUsedAt         DateTime?     @db.Timestamptz(3)

  grants   McpGrant[]
  requests McpAuthorizationRequest[]

  @@map("mcp_clients")
}

// Pedido validado do /oauth/authorize (TTL 10 min, uso único)
model McpAuthorizationRequest {
  id               String    @id @default(uuid()) @db.Uuid
  clientId         String    @db.Uuid
  redirectUri      String
  state            String?
  codeChallenge    String
  scopesRequested  String[]
  resource         String
  userId           String?   @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(3)
  consumedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  // SEC-011: sha256(nonce) do cookie do navegador que iniciou o pedido; nulo só em pedidos anteriores à migração
  browserNonceHash String?

  client McpClient @relation(fields: [clientId], references: [id])

  @@index([expiresAt])
  @@map("oauth_authorization_requests")
}

// "Conexão" do assistente = consentimento de UM membro a UM cliente
model McpGrant {
  id                String            @id @default(uuid()) @db.Uuid
  familyId          String            @db.Uuid
  memberId          String            @db.Uuid
  userId            String            @db.Uuid
  kind              McpGrantKind      @default(OAUTH)
  clientId          String?           @db.Uuid
  label             String
  scopes            String[]
  resource          String
  status            McpGrantStatus    @default(ACTIVE)
  expiresAt         DateTime          @db.Timestamptz(3)
  revokedAt         DateTime?         @db.Timestamptz(3)
  revokedReason     McpRevokedReason?
  revokedByMemberId String?           @db.Uuid
  lastUsedAt        DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  // SEC-011: aviso "nova conexão" na Home até ser dispensado
  noticeDismissedAt DateTime?         @db.Timestamptz(3)

  family Family          @relation(fields: [familyId], references: [id])
  member Member          @relation(fields: [familyId, memberId], references: [familyId, id])
  client McpClient?      @relation(fields: [clientId], references: [id])
  tokens McpToken[]
  audits McpAuditEvent[]

  @@unique([familyId, id])
  @@index([familyId, memberId, status])
  @@map("mcp_grants")
}

model McpToken {
  id            String       @id @default(uuid()) @db.Uuid
  grantId       String       @db.Uuid
  kind          McpTokenKind
  tokenHash     String       @unique // sha256 hex do valor (o valor nunca é gravado)
  codeChallenge String? // só CODE
  redirectUri   String? // só CODE
  parentId      String?      @db.Uuid
  expiresAt     DateTime     @db.Timestamptz(3)
  usedAt        DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  grant McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, kind])
  @@index([expiresAt])
  @@map("mcp_tokens")
}

// Limite de taxa em janela fixa, no Postgres (nada em memória: ADR-031 §7)
model McpRateBucket {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@id([key, windowStart])
  @@map("mcp_rate_buckets")
}

// Append-only (gatilho em SQL cru, como ai_consent_events)
model McpAuditEvent {
  id            String          @id @default(uuid()) @db.Uuid
  familyId      String          @db.Uuid
  memberId      String          @db.Uuid
  grantId       String?         @db.Uuid
  clientName    String
  kind          McpAuditKind
  tool          String?
  params        Json            @default("{}")
  outcome       McpAuditOutcome
  errorCode     String?
  proposalId    String?         @db.Uuid
  transactionId String?         @db.Uuid
  durationMs    Int
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  family Family    @relation(fields: [familyId], references: [id])
  member Member    @relation(fields: [familyId, memberId], references: [familyId, id])
  grant  McpGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([familyId, memberId, createdAt(sort: Desc)])
  @@index([grantId, createdAt(sort: Desc)])
  @@map("mcp_audit_events")
}

// ───────── Assinatura mensal no cartão (US-096, ADR-036, spec 12) ─────────
enum SubscriptionChargeStatus {
  POSTED
  SKIPPED_INVOICE_PAID
  SKIPPED_CARD_ARCHIVED
}

model CardSubscription {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @db.Uuid
  cardId            String    @db.Uuid
  description       String // 2..100
  categoryId        String    @db.Uuid
  payerMemberId     String    @db.Uuid
  isSharedExpense   Boolean   @default(false) // US-099
  dayOfMonth        Int // 1..31 (CHECK)
  firstChargeOn     DateTime  @db.Date
  endMonth          DateTime? @db.Date // dia 1; último mês cobrado; null = sem fim
  nextChargeOn      DateTime? @db.Date // atalho do lançamento preguiçoso; null = sem próxima
  endedAt           DateTime? @db.Timestamptz(3)
  endedOn           DateTime? @db.Date
  endedByMemberId   String?   @db.Uuid
  authorMemberId    String    @db.Uuid
  updatedByMemberId String?   @db.Uuid // US-097: quem editou por último ("alterada por")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  family    Family                   @relation(fields: [familyId], references: [id])
  card      CreditCard               @relation(fields: [familyId, cardId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  category  Category                 @relation(fields: [familyId, categoryId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  payer     Member                   @relation("SubscriptionPayer", fields: [familyId, payerMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  author    Member                   @relation("SubscriptionAuthor", fields: [familyId, authorMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  endedBy   Member?                  @relation("SubscriptionEnder", fields: [familyId, endedByMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy Member?                  @relation("SubscriptionUpdater", fields: [familyId, updatedByMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  amounts   CardSubscriptionAmount[]
  charges   SubscriptionCharge[]

  @@unique([familyId, id])
  @@index([familyId, endedAt, nextChargeOn])
  @@index([familyId, cardId])
  @@map("card_subscriptions")
}

// Append-only: valor do mês M = maior fromMonth <= M (empate: createdAt mais recente)
model CardSubscriptionAmount {
  id             String   @id @default(uuid()) @db.Uuid
  familyId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  fromMonth      DateTime @db.Date // dia 1
  amountInCents  BigInt // > 0 (CHECK)
  authorMemberId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  family       Family           @relation(fields: [familyId], references: [id])
  subscription CardSubscription @relation(fields: [familyId, subscriptionId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  author       Member           @relation(fields: [familyId, authorMemberId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([familyId, subscriptionId, fromMonth])
  @@map("card_subscription_amounts")
}

// Um registro por (família, assinatura, mês), sem filtro de exclusão: nunca duplica nem ressuscita
model SubscriptionCharge {
  id               String                   @id @default(uuid()) @db.Uuid
  familyId         String                   @db.Uuid
  subscriptionId   String                   @db.Uuid
  chargeMonth      DateTime                 @db.Date // dia 1
  chargeOn         DateTime                 @db.Date
  status           SubscriptionChargeStatus
  transactionId    String?                  @db.Uuid
  isAmended        Boolean                  @default(false) // US-097
  sharedDowngraded Boolean                  @default(false) // US-099
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)

  family       Family           @relation(fields: [familyId], references: [id])
  subscription CardSubscription @relation(fields: [familyId, subscriptionId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)
  transaction  Transaction?     @relation(fields: [familyId, transactionId], references: [familyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([familyId, subscriptionId, chargeMonth])
  @@unique([familyId, transactionId]) // == transactionId único (uma compra tem uma só família)
  @@map("subscription_charges")
}

// US-100 (ADR-037): transferência prevista; sem efeito no ledger até efetivar (CHECKs em SQL na migração)
model PlannedTransfer {
  id                String                @id @default(uuid()) @db.Uuid
  familyId          String                @db.Uuid
  fromAccountId     String                @db.Uuid
  toAccountId       String                @db.Uuid
  amountInCents     BigInt // > 0 (CHECK)
  dueOn             DateTime              @db.Date
  description       String? // 2..100
  status            PlannedTransferStatus @default(PREVISTA)
  transferGroupId   String?               @db.Uuid
  authorMemberId    String                @db.Uuid
  updatedByMemberId String?               @db.Uuid
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?             @db.Timestamptz(3)
  deletedByMemberId String?               @db.Uuid
  seriesId          String?               @db.Uuid // US-101 (ADR-037 §5)
  occurrenceMonth   DateTime?             @db.Date // dia 1; seriesId nulo <=> occurrenceMonth nulo (CHECK)
  isException       Boolean               @default(false)

  series        RecurringTransfer? @relation(fields: [familyId, seriesId], references: [familyId, id])
  family        Family             @relation(fields: [familyId], references: [id])
  fromAccount   BankAccount        @relation("PlannedTransferFrom", fields: [familyId, fromAccountId], references: [familyId, id])
  toAccount     BankAccount        @relation("PlannedTransferTo", fields: [familyId, toAccountId], references: [familyId, id])
  transferGroup TransferGroup?     @relation(fields: [familyId, transferGroupId], references: [familyId, id])
  author        Member             @relation("PlannedTransferAuthor", fields: [familyId, authorMemberId], references: [familyId, id])

  @@unique([familyId, id])
  @@unique([familyId, transferGroupId])
  @@unique([familyId, seriesId, occurrenceMonth])
  @@index([familyId, status, dueOn])
  @@map("planned_transfers")
}

// US-101 (ADR-037 §5): série mensal de transferência prevista; ocorrências = linhas de planned_transfers
model RecurringTransfer {
  id                    String    @id @default(uuid()) @db.Uuid
  familyId              String    @db.Uuid
  fromAccountId         String    @db.Uuid
  toAccountId           String    @db.Uuid
  amountInCents         BigInt // > 0 (CHECK)
  description           String? // 2..100
  dayOfMonth            Int // 1..31 (CHECK)
  startMonth            DateTime  @db.Date // dia 1
  endMonth              DateTime? @db.Date // dia 1; null = sem fim
  generatedThroughMonth DateTime? @db.Date // último mês já materializado
  endedAt               DateTime? @db.Timestamptz(3)
  endedByMemberId       String?   @db.Uuid
  authorMemberId        String    @db.Uuid
  updatedByMemberId     String?   @db.Uuid
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  family      Family            @relation(fields: [familyId], references: [id])
  fromAccount BankAccount       @relation("RecurringTransferFrom", fields: [familyId, fromAccountId], references: [familyId, id])
  toAccount   BankAccount       @relation("RecurringTransferTo", fields: [familyId, toAccountId], references: [familyId, id])
  author      Member            @relation("RecurringTransferAuthor", fields: [familyId, authorMemberId], references: [familyId, id])
  occurrences PlannedTransfer[]

  @@unique([familyId, id])
  @@index([familyId, endedAt, generatedThroughMonth])
  @@map("recurring_transfers")
}

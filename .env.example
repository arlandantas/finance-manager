# Copie para .env.local e ajuste. Somente placeholders/valores de DEV local: nunca commite segredos reais.
DATABASE_URL="postgresql://finance:finance_dev_password@localhost:5442/finance_dev?schema=public"
# Banco efêmero (tmpfs) usado por testes de integração
TEST_DATABASE_URL="postgresql://finance:finance_test_password@localhost:5443/finance_test?schema=public"

APP_URL="http://localhost:3100"
APP_TIMEZONE="America/Sao_Paulo"

# Auth.js (US-001). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3100"
# Só dev/teste: confia no Host (Auth.js). Em produção, deixe vazio/false.
AUTH_TRUST_HOST="true"
# Origem pública de teste (túnel), ex.: https://xxx.loca.lt. Libera /_next em dev (allowedDevOrigins) e o
# login de teste nesse host exato. NÃO libera /api/dev/clock (sempre só localhost direto). Vazio = só localhost.
APP_PUBLIC_ORIGIN=""
# Outras origens de dev (lista separada por vírgula; host, host:porta ou URL), ex.: o IP da LAN fixo ou um
# nome de máquina: "http://192.168.1.81:3100,meu-pc.exemplo". Vale para /_next (allowedDevOrigins), login de
# teste, CSRF e links de convite. Em dev, IPs privados RFC1918 (10/8, 172.16/12, 192.168/16) e *.local já são
# aceitos automaticamente (o IP pode mudar); APP_DEV_LAN_AUTO=false desliga isso e exige a lista.
# Nada disso vale em produção e /api/dev/clock continua só em localhost direto.
APP_DEV_ORIGINS=""
APP_DEV_LAN_AUTO="true"
# Login de teste (D-GES-11): só em dev; bloqueado quando NODE_ENV=production
AUTH_DEV_LOGIN="true"
# Google real = pendência EXT-01 (agents/manager/pendencias-externas.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail local capturado pelo Mailpit (UI em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="Finance Manager <no-reply@finance-manager.local>"

# Fixa o relógio da aplicação (ISO-8601). Ignorada em produção.
# APP_NOW_OVERRIDE="2026-10-04T15:00:00Z"

# IA / LLM (EN-004, ADR-028). Em dev/teste o provedor é SIMULADO: nenhuma chamada real, nenhuma chave.
# LLM_PROVIDER="fake" (padrão) | "anthropic" (só produção; exige ANTHROPIC_API_KEY, que NUNCA vai ao cliente nem a log)
LLM_PROVIDER="fake"
# Liga os recursos de IA (padrão false). Em produção exige LLM_PROVIDER=anthropic.
AI_FEATURES_ENABLED="true"
# Teto mensal de custo por família, em centavos (padrão 500 = R$ 5,00; D-GES-32). Sobrescrita por família: families.aiMonthlyCapCents.
# LLM_MONTHLY_CAP_CENTS="500"
# SEC-013: teto GLOBAL mensal (todas as famílias, centavos) e e-mail do alarme de 50/80/100 %. OBRIGATÓRIOS em
# produção com IA ligada (o boot falha sem eles). Recomendação do alpha: R$ 50 (5000). Defina também o limite no
# Console da Anthropic. Em dev/teste o padrão é 100000 (não atrapalha).
# LLM_GLOBAL_MONTHLY_CAP_CENTS="5000"
# OPS_ALERT_EMAIL="dono@exemplo.com"
# ANTHROPIC_API_KEY=""
# LLM_MODEL_ANALYSIS="claude-haiku-5-5"
# LLM_USD_BRL_RATE="6"

# --- Produção (Vercel + Prisma Postgres, ADR-031). Dev local NÃO precisa de nada abaixo. ---
# A integração Prisma da Vercel injeta DATABASE_URL/POSTGRES_URL (host direto db.prisma.io) e PRISMA_DATABASE_URL
# (prisma+postgres://, ignorada). O app deriva a URL pooled (pooled.db.prisma.io) do host direto sozinho; o CLI do
# Prisma usa DIRECT_URL (ou DATABASE_URL_UNPOOLED/POSTGRES_URL_NON_POOLING/DATABASE_URL). Ver src/lib/db-url.ts.
# DIRECT_URL=""
# Conexões por instância (padrão 3; o plano Free do Prisma Postgres tem 10 pooled).
# DB_POOL_MAX="3"
# Segredo do Vercel Cron (>= 32 caracteres aleatórios): /api/cron/purge exige "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=""
# Em produção/preview da Vercel (VERCEL_ENV) as travas de AUTH_DEV_LOGIN/APP_HOMOLOG_MODE/APP_NOW_OVERRIDE valem sozinhas.
# APP_DEPLOY_ENV="production"

# --- Servidor MCP / OAuth próprio (EN-006, ADR-030, SDD-024). Desligado por padrão. ---
# Liga /api/mcp, /oauth/* e /.well-known/* (senão respondem 404). Em preview da Vercel nunca liga.
# Em produção exige APP_URL https. Só ligar após o checklist de segurança do SDD-024 §9.
# MCP_ENABLED="false"
# SEC-010: URLs EXATAS (client_id) de clientes OAuth CIMD aceitos, separadas por vírgula. Vazia = nenhum CIMD
# (o DCR segue valendo). Preencha com a URL confirmada do cliente; não há valor padrão.
# MCP_CIMD_ALLOWED_CLIENT_IDS=
# Obsoleta e ignorada: MCP_CIMD_ALLOWED_HOSTS.

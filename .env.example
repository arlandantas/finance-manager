# Copie para .env.local e ajuste. Somente placeholders/valores de DEV local: nunca commite segredos reais.
DATABASE_URL="postgresql://finance:finance_dev_password@localhost:5442/finance_dev?schema=public"
# Banco efêmero (tmpfs) usado por testes de integração
TEST_DATABASE_URL="postgresql://finance:finance_test_password@localhost:5443/finance_test?schema=public"

APP_URL="http://localhost:3100"
APP_TIMEZONE="America/Sao_Paulo"

# Auth.js (US-001). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3100"
# Só dev/teste: confia no Host (Auth.js). Em produção, deixe vazio/false.
AUTH_TRUST_HOST="true"
# Login de teste (D-GES-11): só em dev; bloqueado quando NODE_ENV=production
AUTH_DEV_LOGIN="true"
# Google real = pendência EXT-01 (agents/manager/pendencias-externas.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail local capturado pelo Mailpit (UI em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="Finance Manager <no-reply@finance-manager.local>"

# Fixa o relógio da aplicação (ISO-8601). Ignorada em produção.
# APP_NOW_OVERRIDE="2026-10-04T15:00:00Z"
